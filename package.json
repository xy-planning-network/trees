{
  "name": "@xy-planning-network/trees",
  "version": "0.15.1",
  "description": "",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xy-planning-network/trees.git"
  },
  "files": [
    "config/*",
    "dist/*",
    "src/**/*.css",
    "src/**/*.vue",
    "types/*"
  ],
  "main": "dist/trees.es.js",
  "module": "dist/trees.es.js",
  "style": "src/index.css",
  "unpkg": "dist/trees.umd.js",
  "types": "types/entry.d.ts",
  "sideEffects": [
    "*.css",
    "*.vue"
  ],
  "scripts": {
    "dev": "vite --config vite.docs.config.mts",
    "build": "npm run lint && vue-tsc -p src --emitDeclarationOnly && vite build && npm run copy:types && tsc-alias -p src/tsconfig.json",
    "build:docs": "vue-tsc -p dev --noEmit && vite build --config vite.docs.config.mts",
    "copy:types": "copyfiles -f ./src/*.d.ts ./types",
    "format": "prettier --write src dev",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "preview": "vite preview --config vite.docs.config.mts",
    "typecheck": "npm run typecheck:src && npm run typecheck:docs",
    "typecheck:src": "vue-tsc -p src --noEmit",
    "typecheck:docs": "vue-tsc -p dev --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.7",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "~10.2.0",
    "@vue/eslint-config-typescript": "~14.9.0",
    "autoprefixer": "^10.4.14",
    "copyfiles": "^2.4.1",
    "eslint": "~10.8.0",
    "eslint-plugin-vue": "~10.10.0",
    "globals": "^17.9.0",
    "markdown-it-prism": "^2.3.0",
    "postcss": "^8.4.21",
    "prettier": "^3.0.3",
    "tailwindcss": "^3.3.3",
    "tsc-alias": "^1.8.5",
    "typescript": "~5.4.5",
    "unplugin-vue-components": "^0.27.4",
    "unplugin-vue-markdown": "^32.0.0",
    "vite": "^8.2.0",
    "vue-tsc": "^2.1.10"
  },
  "dependencies": {
    "@floating-ui/vue": "^1.0.1",
    "@headlessui/vue": "^1.4.2",
    "@heroicons/vue": "^2.2.0",
    "@maskito/core": "^3.5.0",
    "@maskito/kit": "^3.5.0",
    "@maskito/vue": "^3.5.0",
    "axios": "^1.19.0",
    "reka-ui": "^2.9.9"
  },
  "peerDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/forms": "^0.5.2",
    "@tailwindcss/typography": "^0.5.2",
    "@vue/eslint-config-prettier": "~10.2.0",
    "@vue/eslint-config-typescript": "~14.9.0",
    "autoprefixer": "^10.4.7",
    "eslint": "~10.8.0",
    "eslint-plugin-vue": "~10.10.0",
    "globals": "^17.7.0",
    "postcss": "^8.4.14",
    "tailwindcss": "^3.1.4",
    "vue": "^3.5.12"
  },
  "engines": {
    "node": "~24.15.0"
  }
}
